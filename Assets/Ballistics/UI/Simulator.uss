#screen { flex-grow: 1; color: rgb(229, 237, 244); }
.header { position: absolute; left: 32px; top: 24px; }
.eyebrow { font-size: 12px; color: rgb(106, 219, 193); -unity-font-style: bold; letter-spacing: 2px; }
.title { font-size: 34px; -unity-font-style: bold; margin-top: 6px; }
.subtitle { font-size: 15px; color: rgb(158, 177, 194); margin-top: 3px; }
.panel, .report-panel { position: absolute; width: 285px; padding: 20px; background-color: rgba(15, 26, 38, 0.95); border-radius: 12px; border-width: 1px; border-color: rgb(47, 68, 83); }
.panel { left: 32px; top: 145px; }
.report-panel { right: 32px; top: 145px; width: 292px; }
.field-label { margin-top: 20px; margin-bottom: 7px; font-size: 14px; }
Slider { height: 28px; }
Slider .unity-base-slider__input { width: 52px; }
#controls .unity-base-text-field__input { background-color: rgb(30, 47, 63); color: rgb(235, 242, 248); border-color: rgb(63, 90, 109); }
#controls .unity-base-popup-field__input { background-color: rgb(30, 47, 63); color: rgb(235, 242, 248); border-color: rgb(63, 90, 109); }
#controls .unity-base-popup-field__text { color: rgb(235, 242, 248); }
#controls .unity-base-text-field__input, #controls .unity-base-popup-field__input { padding-top: 3px; padding-bottom: 3px; padding-left: 8px; padding-right: 8px; }
DropdownField { height: 30px; margin-left: 0; margin-right: 0; }
Button { height: 38px; margin: 5px 0; border-radius: 5px; border-width: 1px; border-color: rgb(63, 90, 109); background-color: rgb(30, 47, 63); color: rgb(230, 240, 247); font-size: 13px; }
Button:hover { background-color: rgb(48, 73, 91); }
Button.primary { background-color: rgb(104, 226, 192); color: rgb(12, 33, 38); -unity-font-style: bold; height: 46px; font-size: 15px; }
Button.primary:hover { background-color: rgb(149, 249, 220); }
Button:disabled { opacity: 0.4; }
.readout { margin-top: 20px; margin-bottom: 12px; font-size: 14px; color: rgb(244, 193, 105); }
.hint { font-size: 12px; white-space: normal; color: rgb(157, 177, 195); margin-top: 8px; }
.status { font-size: 12px; margin-top: 22px; color: rgb(244, 193, 105); white-space: normal; }
.summary { font-size: 22px; -unity-font-style: bold; margin-top: 12px; white-space: normal; }
.report { font-size: 14px; white-space: normal; margin-top: 18px; }
.footer { position: absolute; bottom: 16px; left: 32px; right: 32px; white-space: normal; color: rgb(166, 187, 203); font-size: 11px; }
