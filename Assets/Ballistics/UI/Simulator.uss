#screen { flex-grow: 1; color: rgb(229, 237, 244); }
.panel, .report-panel, .camera-panel { position: absolute; width: 230px; padding: 12px; background-color: rgba(15, 26, 38, 0.93); border-radius: 8px; border-width: 1px; border-color: rgb(47, 68, 83); }
.panel { top: 18px; left: 18px; }
.report-panel { top: 18px; right: 18px; width: 345px; height: 360px; }
.camera-panel { bottom: 18px; left: 18px; width: 242px; }
.camera-panel .field-label { margin-top: 0; }
.field-label { margin-top: 7px; margin-bottom: 3px; font-size: 12px; }
Slider { height: 24px; }
Slider .unity-base-slider__input { width: 45px; }
#camera-angle .unity-base-slider__input { width: 56px; }
#controls .unity-base-text-field__input, .camera-panel .unity-base-text-field__input { background-color: rgb(30, 47, 63); color: rgb(235, 242, 248); border-color: rgb(63, 90, 109); }
#controls .unity-base-popup-field__input { background-color: rgb(30, 47, 63); color: rgb(235, 242, 248); border-color: rgb(63, 90, 109); }
#controls .unity-base-popup-field__text { color: rgb(235, 242, 248); }
#controls .unity-base-text-field__input, .camera-panel .unity-base-text-field__input, #controls .unity-base-popup-field__input { padding-top: 3px; padding-bottom: 3px; padding-left: 8px; padding-right: 8px; }
DropdownField { height: 27px; margin-left: 0; margin-right: 0; }
.mass-row { flex-direction: row; align-items: center; height: 28px; }
.mass-slider { flex-grow: 1; margin-left: 0; margin-right: 5px; }
.mass-input { width: 57px; margin-left: 0; margin-right: 3px; }
.mass-unit { width: 18px; font-size: 10px; color: rgb(158, 177, 194); }
.preserve-switch { margin-top: 6px; margin-left: 0; min-height: 24px; font-size: 10px; color: rgb(184, 200, 212); }
.preserve-switch .unity-toggle__input { margin-left: 0; margin-right: 6px; }
.preserve-switch .unity-toggle__checkmark { width: 30px; height: 16px; border-radius: 8px; border-width: 1px; border-color: rgb(63, 90, 109); background-color: rgb(30, 47, 63); }
.preserve-switch:checked .unity-toggle__checkmark { background-color: rgb(106, 219, 193); border-color: rgb(106, 219, 193); }
Button { height: 31px; margin: 4px 0 0 0; border-radius: 4px; border-width: 1px; border-color: rgb(63, 90, 109); background-color: rgb(30, 47, 63); color: rgb(230, 240, 247); font-size: 12px; }
Button:hover { background-color: rgb(48, 73, 91); }
Button.primary { background-color: rgb(104, 226, 192); color: rgb(12, 33, 38); -unity-font-style: bold; height: 34px; font-size: 12px; margin-top: 10px; }
Button.primary:hover { background-color: rgb(149, 249, 220); }
Button:disabled { opacity: 0.4; }
.live-telemetry { height: 28px; padding-bottom: 8px; font-size: 12px; color: rgb(244, 193, 105); -unity-font-style: bold; border-bottom-width: 1px; border-bottom-color: rgb(47, 68, 83); }
#history { flex-grow: 1; margin-top: 6px; }
.shot-item { margin-bottom: 4px; border-bottom-width: 1px; border-bottom-color: rgb(38, 56, 70); }
.shot-item > .unity-foldout__toggle { min-height: 25px; margin-left: 0; }
.shot-item > .unity-foldout__toggle .unity-label { font-size: 12px; -unity-font-style: bold; color: rgb(229, 237, 244); }
.shot-item > .unity-foldout__content { margin-left: 19px; padding-bottom: 7px; }
.shot-item > .unity-foldout__content .unity-label { font-size: 11px; color: rgb(158, 177, 194); }
.impact-header, .impact-point-row { flex-direction: row; align-items: center; }
.impact-header > .unity-label, .impact-point-row > .unity-label { flex-grow: 1; white-space: normal; }
.impact-marker-button { width: 57px; height: 21px; min-height: 21px; margin: 2px 0 2px 5px; padding-left: 3px; padding-right: 3px; font-size: 9px; }
.impact-details { margin-top: 7px; padding: 6px; background-color: rgba(30, 47, 63, 0.75); border-radius: 3px; }
.impact-details #impact-title { color: rgb(106, 219, 193); -unity-font-style: bold; margin-bottom: 3px; }
#history .unity-scroller--vertical { width: 7px; background-color: rgba(0, 0, 0, 0); }
#history .unity-scroller--vertical .unity-scroller__low-button,
#history .unity-scroller--vertical .unity-scroller__high-button { display: none; }
#history .unity-scroller--vertical .unity-scroller__slider { margin: 0; padding: 0; background-color: rgba(0, 0, 0, 0); }
#history .unity-scroller--vertical .unity-base-slider__tracker { width: 2px; background-color: rgb(38, 56, 70); border-width: 0; }
#history .unity-scroller--vertical .unity-base-slider__dragger-border { background-color: rgba(0, 0, 0, 0); border-width: 0; }
#history .unity-scroller--vertical .unity-base-slider__dragger { width: 5px; background-color: rgb(106, 219, 193); border-width: 0; border-radius: 3px; }
